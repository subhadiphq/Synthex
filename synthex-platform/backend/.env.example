# ═══════════════════════════════════════════════════════════════
# SYNTHEX AI PLATFORM — Environment Variables
# Copy: cp .env.example .env
# NEVER commit .env to GitHub!
# ═══════════════════════════════════════════════════════════════

# ── SERVER ──────────────────────────────────────────────────────
PORT=8000
DEBUG=false
ENVIRONMENT=production
SECRET_KEY=change-this-to-random-string-minimum-32-characters-long

# ── CORS (add your frontend URL here) ───────────────────────────
# ALLOWED_ORIGINS=["https://your-app.vercel.app","http://localhost:3000"]

# ── DATABASE ─────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./synthex.db
# For PostgreSQL (production scale):
# DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname

# ── FREE PROVIDERS — get these first ────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxx
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── BUDGET PROVIDERS (best quality/cost ratio) ────────────────
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── PREMIUM (accessed via OpenRouter — no direct key needed) ──
# ANTHROPIC_API_KEY=sk-ant-xxxx
# OPENAI_API_KEY=sk-xxxx

# ── RATE LIMITS ──────────────────────────────────────────────────
FREE_RPM=10
PRO_RPM=60
FREE_MONTHLY=200

# ── TIMEOUTS (seconds) ───────────────────────────────────────────
PULSE_TIMEOUT=8
ARC_TIMEOUT=30
NEXUS_TIMEOUT=60
FORGE_TIMEOUT=25

# ── FEATURES ─────────────────────────────────────────────────────
ENABLE_SAFETY_CHECK=true
ENABLE_CONTEXT_COMPRESSION=true
ENABLE_CACHING=true
ENABLE_RATE_LIMITING=true
